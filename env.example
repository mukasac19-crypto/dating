# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Upstash Redis for Rate Limiting
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Site URL (used for Stripe success/return URLs; NEXT_PUBLIC_BASE_URL wins if set)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=https://your-production-domain.com

# Stripe billing
# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_... in dev)
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Recurring Price ID of your premium plan (Products → your product → Pricing)
STRIPE_PRICE_ID=price_your-recurring-price-id
# Signing secret for the /api/webhooks/stripe endpoint.
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints it.
# Prod: Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret




